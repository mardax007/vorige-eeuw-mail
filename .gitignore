# Rust / Tauri
target/

# Node
node_modules/
dist/

# Secrets: never commit
.env
.env.*
!.env.example
secrets/
*.key
*.jks
*.keystore
keystore.properties
client_secret*.json
*.pfx
*.p12

# Real mail and mail stores
*.pst
*.ost
*.dbx
*.MSMessageStore
*.edb
*.eml
*.mbox
*.vcf
testdata/real/
# Generated, made-up samples may be committed, only from here:
!testdata/samples/**
# The empty example file of the vendored outlook-pst (no mail in it)
!vendor/outlook-pst/examples/Empty.pst

# Local app data
*.sqlite
*.sqlite-*
*.db
*.db-*

# OS
Thumbs.db
.DS_Store

# Tool caches
.ruff_cache/

# Tauri generated
src-tauri/gen/schemas
# Rescue tool, copied from MSYS2 by scripts/rescue-tool.mjs
src-tauri/rescue/*
!src-tauri/rescue/.gitkeep
dist-ssr
*.local
*.log
.serena/

# No iPhone version: tauri icon makes these anyway
src-tauri/icons/ios/
dist-android/
