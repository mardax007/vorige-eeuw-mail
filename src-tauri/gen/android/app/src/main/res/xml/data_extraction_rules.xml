<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: mail stays on the phone. Nothing goes into the Google backup or to
     another phone (decision 17 November 2026, docs/DECISIONS.md). The mailboxes fetch their mail
     again on a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
